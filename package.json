{
  "name": "bayze-mcp",
  "version": "0.13.3",
  "description": "Bayze — 本地运行、可审计的开源 AI 模型路由核心（MCP stdio）：草稿 → 结构化评审 → 按需修订 的多模型工作流，BYOK，无遥测",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caijianxiong2007-prog/bayze-mcp.git"
  },
  "homepage": "https://github.com/caijianxiong2007-prog/bayze-mcp#readme",
  "bugs": "https://github.com/caijianxiong2007-prog/bayze-mcp/issues",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "bayze": "dist/src/cli.js"
  },
  "main": "dist/src/index.js",
  "files": [
    "dist/src",
    "docs",
    "examples",
    "CHANGELOG.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "llm",
    "ai",
    "router",
    "multi-model",
    "waterfall",
    "review",
    "byok",
    "local-first"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"const{copyFileSync}=require('fs');copyFileSync('src/transport/http/webui.html','dist/src/transport/http/webui.html')\"",
    "test": "npm run build && node --test dist/tests/unit/*.test.js",
    "check": "node dist/src/cli.js config check",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "yaml": "^2.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
